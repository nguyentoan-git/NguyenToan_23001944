<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Bài 1 - Quản lý sản phẩm</title>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.5; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background-color: #f4f4f4; }
    .badge { padding: 4px 8px; border-radius: 4px; color: #fff; font-size: 0.85em; }
    .bg-green { background-color: #28a745; }
    .bg-red { background-color: #dc3545; }
    .filter-section, .form-section { border: 1px solid #e0e0e0; padding: 15px; margin-bottom: 15px; border-radius: 5px; }
    .message { color: #d9534f; font-weight: bold; margin-top: 5px; }
    .form-group { margin-bottom: 10px; }
    .form-group label { display: inline-block; width: 120px; }
  </style>
</head>
<body>
  <div id="app">
    <h2>Quản lý sản phẩm (Trạng thái: {{ status }})</h2>

    <!-- Tìm kiếm, Lọc và Sắp xếp -->
    <div class="filter-section">
      <div class="form-group">
        <label>Tìm kiếm:</label>
        <input type="text" v-model="searchKey" placeholder="Nhập tên sản phẩm...">
        <p v-if="searchNotice" class="message">{{ searchNotice }}</p>
      </div>

      <div class="form-group">
        <label>Lọc danh mục:</label>
        <select v-model="selectedCategory">
          <option value="">Tất cả danh mục</option>
          <option v-for="cat in categories" :key="cat" :value="cat">{{ cat }}</option>
        </select>
      </div>

      <div class="form-group">
        <label>Sắp xếp giá:</label>
        <select v-model="sortOrder">
          <option value="asc">Tăng dần</option>
          <option value="desc">Giảm dần</option>
        </select>
      </div>
    </div>

    <!-- Thêm sản phẩm mới -->
    <div class="form-section">
      <h3>Thêm sản phẩm mới</h3>
      <form @submit.prevent="addProduct">
        <div class="form-group">
          <label>Tên sản phẩm:</label>
          <input type="text" v-model="newProduct.name" required>
        </div>
        <div class="form-group">
          <label>Giá (VNĐ):</label>
          <input type="number" v-model.number="newProduct.price" required>
        </div>
        <div class="form-group">
          <label>Danh mục:</label>
          <select v-model="newProduct.category" required>
            <option value="Điện tử">Điện tử</option>
            <option value="Gia dụng">Gia dụng</option>
            <option value="Thời trang">Thời trang</option>
          </select>
        </div>
        <div class="form-group">
          <label>Tồn kho:</label>
          <input type="number" v-model.number="newProduct.stock" required>
        </div>
        <button type="submit">Thêm sản phẩm</button>
        <p v-if="errorMessage" class="message">{{ errorMessage }}</p>
      </form>
    </div>

    <!-- Bảng danh sách -->
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Tên sản phẩm</th>
          <th>Danh mục</th>
          <th>Giá</th>
          <th>Tồn kho</th>
          <th>Trạng thái</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="p in filteredProducts" :key="p.id">
          <td>{{ p.id }}</td>
          <td>{{ p.name }}</td>
          <td>{{ p.category }}</td>
          <td>{{ p.price.toLocaleString() }} đ</td>
          <td>{{ p.stock }}</td>
          <td>
            <span :class="['badge', p.stock > 0 ? 'bg-green' : 'bg-red']">
              {{ p.stock > 0 ? 'Còn hàng' : 'Hết hàng' }}
            </span>
          </td>
          <td>
            <button @click="deleteProduct(p.id)">Xóa</button>
          </td>
        </tr>
        <tr v-if="filteredProducts.length === 0">
          <td colspan="7" style="text-align: center;">Không tìm thấy sản phẩm phù hợp.</td>
        </tr>
      </tbody>
    </table>

    <!-- Thống kê dùng computed -->
    <div style="margin-top: 15px; font-weight: bold;">
      <p>Hiển thị: {{ statistics.displayCount }} / {{ statistics.totalCount }} sản phẩm</p>
      <p>Tổng giá trị tồn kho (đang hiển thị): {{ statistics.totalValue.toLocaleString() }} VNĐ</p>
    </div>
  </div>

  <script src="app1.js"></script>
</body>
</html>
