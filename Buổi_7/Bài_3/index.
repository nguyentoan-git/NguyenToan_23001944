<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Bài 3 - Giỏ hàng với props và $emit</title>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    table { width: 100%; max-width: 650px; border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: center; }
    th { background: #f0f0f0; }
    .empty-cart { font-weight: bold; color: #777; font-style: italic; margin-top: 15px; }
    .summary { width: 100%; max-width: 650px; margin-top: 15px; padding: 10px; background: #eef; font-weight: bold; border-radius: 5px; }
  </style>
</head>
<body>
  <div id="app">
    <h2>Giỏ hàng của bạn</h2>

    <div v-if="gioHang.length === 0" class="empty-cart">
      Giỏ hàng trống
    </div>

    <div v-else>
      <table>
        <thead>
          <tr>
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr 
            is="vue:dong-gio-hang" 
            v-for="item in gioHang" 
            :key="item.id"
            :item="item"
            @doi-so-luong="capNhatSoLuong"
            @yeu-cau-xoa="xoaSanPham">
          </tr>
        </tbody>
      </table>

      <!-- Thống kê tổng số lượng và tổng tiền -->
      <div class="summary">
        <p>Tổng số lượng: {{ tongSoLuong }} sản phẩm</p>
        <p>Tổng tiền: {{ tongTien.toLocaleString() }} đồng</p>
      </div>
    </div>
  </div>

  <script src="app3.js"></script>
</body>
</html>
